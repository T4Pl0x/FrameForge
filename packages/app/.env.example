# Repo root (absolute) so dev loaders/globs can read files
VITE_REPO_ROOT=/absolute/path/to/FrameForge

# Gates summary (dev); GateBadges polls this JSON every 10s
VITE_GATES_SUMMARY_PATH=/.echo/gate-summary.json

# Feature flags (default OFF): flip on locally for review
# OS Shell
# VITE_FF_OS_DESKTOP=1
# VITE_FF_OS_WINDOWS=1
# VITE_FF_OS_LAUNCHER=1
# VITE_FF_OS_TRAY=1
# VITE_FF_OS_NOTIFS=1

# Prompt Lab / EPG
# VITE_FF_PROMPT_LAB=1

# Approvals Drawer (dev-only endpoints wired)
# VITE_FF_APPROVALS_DRAWER=1

# Expose dev-only endpoints (/__ff/*) — requires NODE_ENV=development
# Must be explicitly turned on to avoid accidental exposure.
# VITE_EXPOSE_DEV=1

# Codegen autoload in dev
# VITE_FF_CODEGEN=1

# Agents / RAG / Tools
# VITE_FF_AGENT_PANEL=1
# VITE_FF_RAG=1
# VITE_FF_TOOL_HUB=1

# Prod extension loading (loads directly from dist paths vs dev fs paths)
# VITE_FF_EXT_PROD=1


# GitHub token used by dev GH proxy (server-side only)
# VITE_GH_TOKEN=
