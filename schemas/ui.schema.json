{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frameforge.local/schemas/ui.schema.json",
  "type": "object",
  "properties": {
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "number" },
          "isDefault": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "width": { "type": "number", "minimum": 0 },
          "height": { "type": "number", "minimum": 0 },
          "title": { "type": "string" },
          "screenId": { "type": "string" },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "props"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "content": { "type": "string" },
                "props": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "required": ["screens", "frames"],
  "additionalProperties": true
}

